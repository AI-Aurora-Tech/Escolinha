{
  "rewrites": [
    {
      "source": "/api/mp/:path*",
      "destination": "https://api.mercadopago.com/:path*"
    },
    {
      "source": "/api/places/:path*",
      "destination": "https://places.googleapis.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

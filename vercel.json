{
  "rewrites": [
    {
      "source": "/api/mp/:path*",
      "destination": "https://api.mercadopago.com/:path*"
    },
    {
      "source": "/api/zapi/:path*",
      "destination": "https://api.z-api.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}